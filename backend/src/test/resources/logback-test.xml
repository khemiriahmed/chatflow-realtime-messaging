<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.ahmed.chatflow" level="WARN"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
</configuration>
