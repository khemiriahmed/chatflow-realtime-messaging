# PostgreSQL (utilisé par docker-compose.yml et le backend)
DB_URL=jdbc:postgresql://postgres:5432/chatflow
DB_USERNAME=chatflow
DB_PASSWORD=change-me-in-production

# JWT — clé Base64 d'au moins 32 octets (HS256). Générer avec : openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_YOUR_OWN_BASE64_SECRET
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=chatflow
JWT_AUDIENCE=chatflow-web

# Origines autorisées (séparées par des virgules, sans wildcard avec credentials)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200

# Port du backend
SERVER_PORT=8080
